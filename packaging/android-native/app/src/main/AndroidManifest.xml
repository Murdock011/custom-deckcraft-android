<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Custom DeckCraft"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">
        <!-- singleTask: one instance (one native UI loop per process). A workbook opened from another app
             comes to onNewIntent of this instance instead of starting a second one. -->
        <activity
            android:name="ai.storyteller.deckcraft.nativeapp.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|layoutDirection|fontScale|density|locale|touchscreen|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <meta-data
                android:name="android.app.lib_name"
                android:value="deckcraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open with: Files, mail and browsers offer DeckCraft for these types. The list matches
                 the extensions `nativeAccepts` checks (see `android.rs`); keep the two in step. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.template" />
            </intent-filter>

            <!-- Some providers send .pptx as application/octet-stream: accept it by its name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathSuffix=".pptx" />
                <data android:pathSuffix=".PPTX" />
                <data android:pathSuffix=".ppsx" />
                <data android:pathSuffix=".PPSX" />
                <data android:pathSuffix=".deckcraft" />
            </intent-filter>

            <!-- Edit: a provider that wants the presentation edited in place. -->
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.template" />
            </intent-filter>

            <!-- Share: a presentation sent to DeckCraft from the share sheet (its stream, EXTRA_STREAM). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.template" />
            </intent-filter>
        </activity>

        <!-- Restarts the app after the system recreated MainActivity (see RestartActivity). It has its own
             process so it outlives the one it ends. -->
        <activity
            android:name="ai.storyteller.deckcraft.nativeapp.RestartActivity"
            android:exported="false"
            android:process=":restart"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
